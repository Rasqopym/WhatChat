# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-webhooks

# Meta WhatsApp Cloud API
# Found under Meta for Developers -> Your App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# AI Co-Pilot (Gemini API)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# Optional: Base URL for webhooks in local testing (e.g. ngrok or deployed Vercel domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
